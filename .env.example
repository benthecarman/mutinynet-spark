SSP_LISTEN_ADDR=127.0.0.1:5000
SSP_NETWORK=REGTEST
# Leave both empty: first boot generates SSP_DATA_DIR/ssp.key and publishes
# the pubkey on /health. Set both (matching pair) to pin an identity.
SSP_IDENTITY_PUBKEY=
SSP_SECRET_KEY_HEX=
SSP_DATA_DIR=./data
# Live LDK backend (empty LDK_GRPC_ADDR = fake mode):
LDK_GRPC_ADDR=
LDK_API_KEY=
LDK_API_KEY_FILE=
LDK_TLS_CERT_FILE=
SSP_LN_FEE_PPM=0
SSP_SWAP_FEE_SATS=0
# FROST share storage: SO identifiers + identity pubkeys (JSON), threshold
# matching the SO signing threshold. Empty = skip share storage.
SSP_FROST_THRESHOLD=2
SSP_FROST_OPERATORS=
RUST_LOG=info
