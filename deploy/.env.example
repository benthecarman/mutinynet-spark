# Copy to deploy/.env (NEVER commit the filled copy). All values required
# unless marked optional.

# --- edge ---
SSP_DOMAIN=ssp.example.com
ACME_EMAIL=ops@example.com

# --- SSP identity guard (optional; the mnemonic is the source of truth) ---
SSP_IDENTITY_PUBKEY=
SSP_CORS_ORIGINS=https://wallet.example.com
SPARK_MNEMONIC_FILE=/spark-data/sidecar.mnemonic

# --- shared secrets (generate: openssl rand -hex 32) ---
SPARK_ADMIN_TOKEN=
LDK_API_KEY=

# --- networks/hosts (regtest defaults; point at MutinyNet infra) ---
SSP_NETWORK=SIGNET
SO_HOSTS=spark-operator-0:8535,spark-operator-1:8535,spark-operator-2:8535
SO_IDENTITY_PUBKEYS=
# Leave empty for public certificates. Use a matching comma-separated list
# for private operator CAs.
SO_CERT_FILES=
BITCOIN_RPC_URL=
BITCOIN_RPC_USER=
BITCOIN_RPC_PASSWORD=
LDK_GRPC_ADDR=ldk-server:3536
LDK_API_KEY_FILE=
LDK_TLS_CERT_FILE=/path/to/ldk-server/tls.crt

# --- checkouts used for image builds ---
SPARK_REF=/tmp/opencode/spark-ref
LDK_SERVER_REF=/tmp/opencode/ldk-server-ref
