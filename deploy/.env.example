# Copy to deploy/.env (NEVER commit the filled copy). All values required
# unless marked optional. Empty SSP keys = generate on first boot.

# --- edge ---
SSP_DOMAIN=ssp.example.com
ACME_EMAIL=ops@example.com

# --- SSP identity (leave empty to generate into the ssp-data volume) ---
SSP_IDENTITY_PUBKEY=
SSP_SECRET_KEY_HEX=

# --- shared secrets (generate: openssl rand -hex 32) ---
SIDECAR_TOKEN=
LDK_API_KEY=

# --- networks/hosts (regtest defaults; point at MutinyNet infra) ---
SSP_NETWORK=SIGNET
SO_HOSTS=spark-operator-0:8535,spark-operator-1:8535,spark-operator-2:8535
BITCOIN_RPC_URL=http://bitcoind:8332
BITCOIN_RPC_USER=testutil
BITCOIN_RPC_PASSWORD=changeme
LDK_GRPC_ADDR=ldk-server:3536

# --- checkouts used for image builds ---
SPARK_REF=/tmp/opencode/spark-ref
LDK_SERVER_REF=/tmp/opencode/ldk-server-ref
